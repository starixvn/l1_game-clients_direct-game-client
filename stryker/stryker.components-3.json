{
    "extends": "./stryker.base.json",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true,
        "testMatch": [
            "<rootDir>/src/components/timeout/__tests__/index.test.tsx",
            "<rootDir>/src/components/not-found/__tests__/index.test.tsx",
            "<rootDir>/src/components/common/loading/__tests__/index.test.tsx"
        ]
    },
    "mutate": [
        "src/components/timeout/index.tsx",
        "src/components/not-found/index.tsx",
        "src/components/common/loading/index.tsx"
    ]
}