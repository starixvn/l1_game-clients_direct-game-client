{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "packageManager": "npm",
    "reporters": [
        "html",
        "clear-text",
        "progress"
    ],
    "testRunner": "jest",
    "coverageAnalysis": "perTest",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true,
        "testMatch": [
            "<rootDir>/src/components/timeout/__tests__/index.test.tsx",
            "<rootDir>/src/components/not-found/__tests__/index.test.tsx",
            "<rootDir>/src/components/common/loading/__tests__/index.test.tsx"
        ]
    },
    "checkers": [
        "typescript"
    ],
    "tsconfigFile": "tsconfig.json",
    "mutate": [
        "src/components/timeout/index.tsx",
        "src/components/not-found/index.tsx",
        "src/components/common/loading/index.tsx"
    ],
    "ignorePatterns": [
        "node_modules",
        "dist",
        "coverage",
        "reports",
        "**/__tests__/**",
        "**/__mocks__/**"
    ],
    "inPlace": true,
    "threads": 3,
    "timeoutMS": 20000,
    "testRunnerNodeArgs": [
        "--max-old-space-size=4096"
    ]
}