{
    "extends": "./stryker.base.json",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true
    },
    "mutate": [
        "src/_shared/**/*.ts",
        "src/_shared/**/*.tsx",
        "!src/_shared/**/__tests__/**/*",
        "!src/_shared/**/__mocks__/**/*"
    ]
}