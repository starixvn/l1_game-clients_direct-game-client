{
    "extends": "./stryker.base.json",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true,
        "testMatch": [
            "<rootDir>/src/components/um/__tests__/index.test.tsx",
            "<rootDir>/src/components/landscape-mode/__tests__/index.test.tsx",
            "<rootDir>/src/components/non-offer/__tests__/index.test.tsx"
        ]
    },
    "mutate": [
        "src/components/um/index.tsx",
        "src/components/landscape-mode/index.tsx",
        "src/components/non-offer/index.tsx"
    ]
}