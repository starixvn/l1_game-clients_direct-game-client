{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "packageManager": "npm",
    "reporters": [
        "html",
        "clear-text",
        "progress"
    ],
    "testRunner": "jest",
    "coverageAnalysis": "perTest",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true,
        "testMatch": [
            "<rootDir>/src/__tests__/App.test.tsx",
            "<rootDir>/src/tolgee.test.ts"
        ]
    },
    "checkers": [
        "typescript"
    ],
    "tsconfigFile": "tsconfig.json",
    "mutate": [
        "src/App.tsx",
        "src/index.tsx",
        "src/tolgee.ts"
    ],
    "ignorePatterns": [
        "node_modules",
        "dist",
        "coverage",
        "reports",
        "**/__tests__/**",
        "**/__mocks__/**"
    ],
    "inPlace": true,
    "threads": 2,
    "timeoutMS": 20000,
    "testRunnerNodeArgs": [
        "--max-old-space-size=4096"
    ]
}