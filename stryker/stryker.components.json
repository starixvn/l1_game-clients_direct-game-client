{
    "extends": "./stryker.base.json",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true
    },
    "mutate": [
        "src/components/**/*.ts",
        "src/components/**/*.tsx",
        "!src/components/**/__tests__/**/*",
        "!src/components/**/__mocks__/**/*"
    ]
}