{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "packageManager": "npm",
    "reporters": [
        "html",
        "clear-text",
        "progress"
    ],
    "testRunner": "jest",
    "coverageAnalysis": "perTest",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true
    },
    "checkers": [
        "typescript"
    ],
    "tsconfigFile": "tsconfig.json",
    "threads": 4,
    "concurrency": 4,
    "timeoutMS": 20000,
    "ignorePatterns": [
        "node_modules",
        "dist",
        "coverage",
        "reports",
        "**/__tests__/**",
        "**/__mocks__/**"
    ],
    "inPlace": true,
    "testRunnerNodeArgs": [
        "--max-old-space-size=4096"
    ]
}