{
    "extends": "./stryker.base.json",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true
    },
    "mutate": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "!src/**/__tests__/**/*",
        "!src/**/__mocks__/**/*",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
    ]
}