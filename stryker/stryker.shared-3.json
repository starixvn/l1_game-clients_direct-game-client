{
    "extends": "./stryker.base.json",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true,
        "testMatch": [
            "<rootDir>/src/_shared/utils/__tests__/player-setting.test.ts",
            "<rootDir>/src/_shared/utils/__tests__/session-manager.test.ts"
        ]
    },
    "mutate": [
        "src/_shared/utils/player-setting.ts",
        "src/_shared/utils/session-manager.ts"
    ]
}