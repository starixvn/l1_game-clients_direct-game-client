{
    "extends": "./stryker.base.json",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true,
        "testMatch": [
            "<rootDir>/src/_shared/utils/__tests__/storage-manager.test.ts",
            "<rootDir>/src/_shared/utils/__tests__/game-event-manager.test.ts"
        ]
    },
    "mutate": [
        "src/_shared/utils/storage-manager.ts",
        "src/_shared/utils/game-event-manager.ts"
    ]
}