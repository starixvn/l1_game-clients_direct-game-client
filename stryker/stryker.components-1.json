{
    "extends": "./stryker.base.json",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true,
        "testMatch": [
            "<rootDir>/src/components/lobby/__tests__/index.test.tsx",
            "<rootDir>/src/components/lobby/__tests__/game-tabs.test.tsx",
            "<rootDir>/src/components/lobby/__tests__/game-frame.test.tsx"
        ]
    },
    "mutate": [
        "src/components/lobby/index.tsx",
        "src/components/lobby/game-tabs.tsx",
        "src/components/lobby/game-frame.tsx"
    ]
}